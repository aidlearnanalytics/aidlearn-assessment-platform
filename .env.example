# Supabase Postgres connection (use the "pooled" connection string for DATABASE_URL,
# and the direct connection for DIRECT_URL if your Prisma version needs it)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Filled in during Stage 9
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
