generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  REVIEWER
}

enum QuestionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum QuestionSource {
  HUMAN
  AI_GENERATED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  FORMULA_ENTRY
}

enum AttemptStatus {
  REGISTERED
  IN_PROGRESS
  SUBMITTED
  TERMINATED
  EXPIRED
}

enum ViolationType {
  TAB_SWITCH
  VISIBILITY_HIDDEN
  FULLSCREEN_EXIT
  SCREEN_SHARE_STOPPED
  COPY_PASTE
  DEVTOOLS_OPEN
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          AdminRole @default(SUPER_ADMIN)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approvedQuestions Question[] @relation("QuestionApprover")
  createdQuestions  Question[] @relation("QuestionCreator")
}

model Company {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  industry       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admins        AdminUser[]
  assessments   Assessment[]
  participants  Participant[]
  questions     Question[]
}

model Skill {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
}

model Question {
  id            String         @id @default(cuid())
  prompt        String
  type          QuestionType   @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer String?
  explanation   String?
  difficulty    String
  industry      String?
  points        Int            @default(1)

  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  skillId       String?
  skill         Skill?         @relation(fields: [skillId], references: [id])
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])

  source        QuestionSource @default(HUMAN)
  status        QuestionStatus @default(APPROVED)

  createdById   String?
  createdBy     AdminUser?     @relation("QuestionCreator", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    AdminUser?     @relation("QuestionApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  assessmentQuestions AssessmentQuestion[]
  answers             Answer[]
}

model Assessment {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  durationMinutes    Int      @default(45)
  numQuestions       Int      @default(20)
  difficultyMix      Json?
  categories         Json?

  randomizeQuestions Boolean  @default(true)
  randomizeOptions    Boolean  @default(true)

  requireScreenShare Boolean  @default(false)
  requireFullscreen   Boolean  @default(true)
  monitorTabSwitch   Boolean  @default(true)
  monitorVisibility  Boolean  @default(true)
  maxViolations      Int?

  passingScorePct    Int?     @default(70)

  isPublished        Boolean  @default(true)
  publishedAt        DateTime? @default(now())

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questions          AssessmentQuestion[]
  attempts           AssessmentAttempt[]
}

model AssessmentQuestion {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order          Int        @default(0)
  pointsOverride Int?

  @@unique([assessmentId, questionId])
}

model Participant {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName   String
  email      String
  phone      String?
  department String?
  createdAt  DateTime @default(now())

  attempts   AssessmentAttempt[]

  @@unique([companyId, email])
}

model AssessmentAttempt {
  id               String        @id @default(cuid())
  assessmentId     String
  assessment       Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  participantId    String
  participant      Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  status           AttemptStatus @default(REGISTERED)
  startedAt        DateTime?
  submittedAt      DateTime?
  timeTakenSecs    Int?

  overallScore     Float?
  overallPct       Float?
  categoryScores   Json?
  difficultyScores Json?
  aiDiagnostic     Json?

  answers          Answer[]
  violations       ViolationLog[]

  createdAt        DateTime @default(now())
}

model Answer {
  id            String            @id @default(cuid())
  attemptId     String
  attempt       AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response      Json
  isCorrect     Boolean?
  pointsAwarded Float?
  answeredAt    DateTime          @default(now())

  @@unique([attemptId, questionId])
}

model ViolationLog {
  id         String            @id @default(cuid())
  attemptId  String
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type       ViolationType
  detail     String?
  occurredAt DateTime          @default(now())
}
